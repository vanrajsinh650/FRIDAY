# FRIDAY Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Your Groq API key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Groq model to use (default: llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Server host and port (defaults: 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000
