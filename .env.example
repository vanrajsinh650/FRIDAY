# FRIDAY — environment secrets (example)
#
# Copy to `.env` (gitignored) and fill in real keys, OR export these in your
# shell / CI. `src/config/secrets.ts` reads `process.env.FRIDAY_*` and falls back
# to dev-only constants when unset. Provide real values here for any release
# build so secrets never depend on the in-source dev fallbacks.
#
# React Native: wire these into the JS bundle with react-native-dotenv or
# react-native-config (both populate process.env at build time). Node/Jest read
# process.env directly.

FRIDAY_GROQ_API_KEY=
FRIDAY_NVIDIA_API_KEY=
FRIDAY_OPENAI_API_KEY=
